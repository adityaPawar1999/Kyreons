rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /orders/{orderId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending_payment'
        && request.resource.data.keys().hasOnly([
          'userId', 'email', 'orderNumber', 'customer', 'items', 'subtotal', 'total',
          'currency', 'status', 'createdAt'
        ])
        && request.resource.data.email is string;
      allow get, list: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /newsletterSubscribers/{subscriberId} {
      allow create, update: if request.resource.data.email == subscriberId
        && request.resource.data.keys().hasOnly(['email', 'createdAt'])
        && request.resource.data.email is string;
      allow read, delete: if false;
    }

    match /customerProfiles/{emailId} {
      allow get: if request.auth != null
        && request.auth.uid == emailId;
      allow create, update: if request.auth != null
        && request.auth.uid == emailId
        && request.resource.data.keys().hasOnly([
          'name', 'firstName', 'lastName', 'phone', 'address', 'address2',
          'city', 'region', 'postalCode', 'country', 'email', 'cart', 'updatedAt'
        ])
        && (!('cart' in request.resource.data) || request.resource.data.cart is list);
      allow list, delete: if false;
    }

    match /customerWishlists/{emailId} {
      allow get: if request.auth != null
        && request.auth.uid == emailId;
      allow create, update: if request.auth != null
        && request.auth.uid == emailId
        && request.resource.data.keys().hasOnly(['productIds', 'updatedAt'])
        && request.resource.data.productIds is list;
      allow list, delete: if false;
    }
  }
}
