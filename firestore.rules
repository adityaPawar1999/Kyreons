rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function validOrderStatus(status) {
      return status in [
        'pending_payment', 'order_received', 'payment_received', 'in_progress',
        'dispatched', 'delivered', 'return_requested', 'return_in_progress',
        'returned', 'cancelled'
      ];
    }

    match /orders/{orderId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending_payment'
        && request.resource.data.keys().hasOnly([
          'userId', 'email', 'orderNumber', 'customer', 'items', 'subtotal',
          'total', 'currency', 'status', 'createdAt'
        ]);

      allow get, list: if request.auth != null
        && (resource.data.userId == request.auth.uid || isAdmin());

      // Only dashboard admins can change the fulfilment and payment tracking
      // fields. Customers cannot edit orders after checkout.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'paymentStatus', 'currentCity', 'estimatedDeliveryAt',
          'returnEstimatedAt', 'statusUpdatedAt', 'orderReceivedAt'
        ])
        && validOrderStatus(request.resource.data.status)
        && request.resource.data.paymentStatus in ['pending', 'received', 'failed', 'refunded']
        && request.resource.data.currentCity is string
        && request.resource.data.currentCity.size() <= 100
        && request.resource.data.estimatedDeliveryAt is string
        && request.resource.data.returnEstimatedAt is string
        && request.resource.data.statusUpdatedAt == request.time
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['orderReceivedAt'])
          || request.resource.data.orderReceivedAt == request.time);

      allow delete: if false;
    }

    match /newsletterSubscribers/{subscriberId} {
      allow create, update: if request.resource.data.email == subscriberId
        && request.resource.data.email is string
        && request.resource.data.keys().hasOnly(['email', 'createdAt']);

      allow read, delete: if false;
    }

    match /contactMessages/{messageId} {
      allow create: if request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 6
        && request.resource.data.email.size() <= 254
        && request.resource.data.topic is string
        && request.resource.data.topic.size() > 0
        && request.resource.data.topic.size() <= 80
        && request.resource.data.orderNumber is string
        && request.resource.data.orderNumber.size() <= 40
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 5
        && request.resource.data.message.size() <= 3000
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'topic', 'orderNumber', 'message', 'status', 'createdAt'
        ]);

      allow get, list: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['new', 'in_progress', 'handled'];
      allow delete: if false;
    }

    match /customerProfiles/{userId} {
      allow get: if request.auth != null
        && (request.auth.uid == userId || isAdmin());

      allow list: if isAdmin();

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'name', 'firstName', 'lastName', 'phone', 'address', 'address2',
          'city', 'region', 'postalCode', 'country', 'email', 'cart', 'updatedAt'
        ])
        && (!('cart' in request.resource.data)
          || request.resource.data.cart is list);

      allow delete: if false;
    }

    match /customerWishlists/{userId} {
      allow get: if request.auth != null
        && request.auth.uid == userId;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['productIds', 'updatedAt'])
        && request.resource.data.productIds is list;

      allow list: if isAdmin();
      allow delete: if false;
    }

    match /storefrontSessions/{sessionId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.visitorType in ['anonymous', 'customer']
        && request.resource.data.startedAt == request.time
        && request.resource.data.lastSeenAt == request.time
        && request.resource.data.durationSeconds == 0
        && request.resource.data.pageViews == 0
        && request.resource.data.lastRoute is string
        && request.resource.data.lastRoute.size() <= 160
        && request.resource.data.keys().hasOnly(['userId', 'visitorType', 'startedAt', 'lastSeenAt', 'durationSeconds', 'pageViews', 'lastRoute']);

      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeenAt', 'durationSeconds', 'pageViews', 'lastRoute'])
        && request.resource.data.lastSeenAt == request.time
        && request.resource.data.durationSeconds is int
        && request.resource.data.durationSeconds >= resource.data.durationSeconds
        && request.resource.data.pageViews is int
        && request.resource.data.pageViews >= resource.data.pageViews
        && request.resource.data.lastRoute is string
        && request.resource.data.lastRoute.size() <= 160;

      allow get, list: if isAdmin();
      allow delete: if false;
    }

    match /storefrontEvents/{eventId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.visitorType in ['anonymous', 'customer']
        && request.resource.data.type in ['page_view', 'product_view']
        && request.resource.data.sessionId is string
        && request.resource.data.route is string
        && request.resource.data.route.size() <= 160
        && request.resource.data.productId is string
        && request.resource.data.productId.size() <= 100
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly(['sessionId', 'userId', 'visitorType', 'type', 'route', 'productId', 'createdAt']);

      allow get, list: if isAdmin();
      allow update, delete: if false;
    }

    // Admins need a collection-group query to aggregate ratings across products.
    match /{reviewPath=**}/reviews/{reviewId} {
      allow get, list: if isAdmin();
    }

    match /review/{productId} {
      allow get, list: if true;
      allow create, update, delete: if false;

      match /reviews/{reviewId} {
        allow get, list: if true;

        allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'userId', 'name', 'rating', 'comment', 'date', 'createdAt'
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.comment is string
          && (request.resource.data.comment.size() == 0
            || request.resource.data.comment.size() >= 3)
          && request.resource.data.comment.size() <= 1000
          && request.resource.data.date is string
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }
    }
  }
}
